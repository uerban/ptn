{
  "name": "@pt/backend",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../../scripts/build-info.mjs . src/generated/buildInfo.ts",
    "predev": "node ../../scripts/build-info.mjs . src/generated/buildInfo.ts",
    "predev:shim": "node ../../scripts/build-info.mjs . src/generated/buildInfo.ts",
    "pretest": "node ../../scripts/build-info.mjs . src/generated/buildInfo.ts",
    "pretest:integration": "node ../../scripts/build-info.mjs . src/generated/buildInfo.ts",
    "pretypecheck": "node ../../scripts/build-info.mjs . src/generated/buildInfo.ts",
    "dev": "tsx watch src/index.ts",
    "dev:shim": "tsx watch src/adapterShim.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=1 vitest run",
    "build-poi-bundles": "tsx src/poi/buildAllBundles.ts",
    "generate-poi-release-notes": "tsx src/poi/releaseNotes.ts",
    "harness": "tsx src/harness/run.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10",
    "@fastify/static": "^10.1.2",
    "@pt/shared": "workspace:*",
    "csv-parse": "^7.0.2",
    "culori": "^4.0.2",
    "fastify": "^5.12.6",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^1.1.1",
    "lru-cache": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "yaml": "^2.8.3"
  }
}
