{
  "name": "@pt/frontend",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/check-pt-wasm-pkg-web.mjs && node ../../scripts/check-i18n-parity.mjs --syntax-only",
    "build": "tsc -b && vite build && node scripts/precompress-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=America/New_York vitest run --config vitest.tz.config.ts && TZ=Europe/Vilnius vitest run --config vitest.tz.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "e2e:validate": "playwright test --project=validate e2e/core/",
    "e2e:pr": "playwright test --project=pr-chromium --project=pr-webkit e2e/core/",
    "e2e:staging": "playwright test --project=staging e2e/core/",
    "e2e:full": "playwright test e2e/",
    "e2e:offline": "pnpm build && E2E_PREVIEW=1 playwright test --project=offline e2e/core/offline.spec.ts e2e/core/text-mode.spec.ts e2e/poi/offline-search.spec.ts",
    "e2e:privacy": "playwright test --project=pr-chromium --grep @mock-api e2e/core/privacy-nearby.spec.ts",
    "e2e:smoke": "playwright test e2e/smoke/",
    "e2e:perf": "playwright test --project=perf e2e/perf/",
    "test:fuzz": "vitest run tests/m10-coarsen-fuzz.test.ts",
    "test:privacy-harness": "playwright test --config=tests/privacy-harness/playwright.config.ts",
    "size": "size-limit",
    "size:check": "size-limit --limit && node scripts/check-text-entry-chunks.mjs",
    "bench": "vitest bench --config vitest.bench.config.ts --run",
    "bench:check": "vitest bench --config vitest.bench.config.ts --run --outputJson tests/benchmarks/.results.json",
    "lhci": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@pt/shared": "workspace:*",
    "brotli-dec-wasm": "^2.3.2",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.0",
    "maplibre-gl": "^6.4.1",
    "@pt/wasm": "workspace:pt-wasm@*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.58.2",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.0.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.6.0",
    "jest-axe": "^9.0.0",
    "@types/jest-axe": "^3.5.9",
    "jsdom": "^26.0.0",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
