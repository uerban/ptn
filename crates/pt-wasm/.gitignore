# pkg-web/ is a wasm-pack build artifact (regenerated by the setup-pt-wasm-pkg-web
# action). We intentionally track ONLY pkg-web/package.json so `pnpm install` can
# resolve the pt-wasm@workspace:* link in a clean checkout (Dependabot, fresh
# worktrees, CI preflight) WITHOUT first running wasm-pack. wasm-pack regenerates
# a byte-identical package.json, so the tracked file stays churn-free. Every other
# build output stays ignored.
pkg-web/*
!pkg-web/package.json
pkg-node/
target/
# Opt-in arrive-by experiment package (scripts/build-pt-wasm-arrive-by.mjs).
# Only a PTN_ARRIVE_BY_EXPERIMENT=1 frontend build reads it.
pkg-web-arrive-by/
